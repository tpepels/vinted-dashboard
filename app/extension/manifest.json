{
  "manifest_version": 3,
  "name": "Vinted Dashboard Sync",
  "version": "1.0.0",
  "description": "Syncs Vinted dashboard data from your signed-in Vinted tab to your local media-server dashboard.",
  "permissions": ["storage", "alarms", "tabs"],
  "host_permissions": [
    "https://www.vinted.pt/*",
    "http://media-server/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.vinted.pt/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Vinted Dashboard Sync",
    "default_popup": "popup.html"
  }
}
