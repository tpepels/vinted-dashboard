{
  "manifest_version": 3,
  "name": "Vinted Dashboard Sync",
  "version": "1.1.0",
  "description": "Syncs Vinted data to your local dashboard and performs on-demand comparable-price research.",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://www.vinted.pt/*",
    "http://media-server/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.vinted.pt/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Vinted Dashboard Sync",
    "default_popup": "popup.html"
  }
}
