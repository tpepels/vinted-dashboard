{
  "manifest_version": 3,
  "name": "Vinted Dashboard Sync",
  "version": "1.2.0",
  "description": "Syncs Vinted inventory, audience metrics, views and on-demand market research to your local dashboard.",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://www.vinted.pt/*",
    "http://media-server/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.vinted.pt/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Vinted Dashboard Sync",
    "default_popup": "popup.html"
  }
}
