{
  "manifest_version": 3,
  "name": "Reseller Dashboard Chrome Bridge",
  "version": "3.0.1",
  "description": "Connects your signed-in Vinted tab to your reseller workspace for inventory and analytics sync.",
  "permissions": [
    "storage",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://www.vinted.pt/*",
    "https://www.vinted.fr/*",
    "https://www.vinted.nl/*",
    "https://www.vinted.be/*",
    "https://www.vinted.it/*",
    "https://www.vinted.es/*",
    "https://www.vinted.lu/*",
    "https://www.vinted.co.uk/*",
    "https://www.vinted.de/*",
    "https://www.vinted.pl/*",
    "__API_HOST_PERMISSION__"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.vinted.pt/*",
        "https://www.vinted.fr/*",
        "https://www.vinted.nl/*",
        "https://www.vinted.be/*",
        "https://www.vinted.it/*",
        "https://www.vinted.es/*",
        "https://www.vinted.lu/*",
        "https://www.vinted.co.uk/*",
        "https://www.vinted.de/*",
        "https://www.vinted.pl/*"
      ],
      "js": [
        "vinted_age.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Reseller Dashboard Chrome Bridge",
    "default_popup": "popup.html",
    "icons": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "homepage_url": "__API_ORIGIN__"
}
