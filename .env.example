VINTED_BASE_URL=https://www.vinted.pt
VINTED_USER_ID=58344842
VINTED_PROFILE_URL=https://www.vinted.pt/member/58344842
VINTED_USERNAME=tom_waits

# Keep these empty if you use the "Vinted session" button in the dashboard.
# Never commit real values.
VINTED_COOKIE=
VINTED_ACCESS_TOKEN_WEB=
VINTED_REFRESH_TOKEN_WEB=
VINTED_ANON_ID=
VINTED_CSRF_TOKEN=
VINTED_USER_AGENT=

VINTED_CACHE_SECONDS=60
VINTED_TIMEOUT_SECONDS=20
VINTED_MAX_PAGES=10

# Multi-channel stock
# BIBLIO inventory imports use this currency when the export has no currency column.
BIBLIO_CURRENCY=EUR

# BIBLIO FTP inventory sync. Keep credentials only in .env.
BIBLIO_FTP_HOST=ftp.biblio.com
BIBLIO_FTP_USERNAME=
BIBLIO_FTP_PASSWORD=
# BIBLIO recommends blank or ./ for the FTP directory.
BIBLIO_FTP_DIRECTORY=
BIBLIO_FTP_TIMEOUT_SECONDS=20
BIBLIO_FTP_FILENAME_PREFIX=vinted-dashboard
# Turn this on only after Test FTP succeeds and a full BIBLIO download has
# been imported so required fields such as Description are available locally.
BIBLIO_FTP_AUTO_SYNC=false

# eBay: either provide a current user access token directly...
EBAY_OAUTH_TOKEN=

# ...or preferably configure refreshable OAuth credentials.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REFRESH_TOKEN=

# Trading API settings. Site ID 0 = eBay US; change this if your selling site differs.
EBAY_SITE_ID=0
EBAY_COMPATIBILITY_LEVEL=1477
