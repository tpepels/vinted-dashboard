# Product / hosted-app settings
APP_NAME=Reseller Dashboard
# development (permissive local defaults) or production (strict hosted validation)
APP_ENV=development
# Local-only fallback used to derive an encryption key when APP_ENCRYPTION_KEY
# is empty. Production rejects derived-key mode, so this is not a production secret.
APP_SECRET_KEY=development-only-change-me
# Production: generate a Fernet key (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
APP_ENCRYPTION_KEY=
PUBLIC_APP_URL=http://localhost:5050
# Required in production; rendered on the public privacy policy.
PRIVACY_CONTACT_EMAIL=
COOKIE_SECURE=false
AUTH_SESSION_DAYS=30
PASSWORD_HASH_ITERATIONS=310000
EXTENSION_LATEST_VERSION=3.1.0

# Optional photo-to-listing assistant. Photos are sent only when the user
# explicitly clicks Analyze and are not persisted by the dashboard.
LISTING_ASSISTANT_ENABLED=false
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-6-luna

# Hosted release operations. BACKUP_PROVIDER names the managed snapshot/dump
# mechanism; BACKUP_RESTORE_DRILL_AT records the last verified restore drill
# as YYYY-MM-DD and is checked by scripts/release_readiness.py.
BACKUP_PROVIDER=
BACKUP_RESTORE_DRILL_AT=

# Billing is optional; local/beta installs need none of these.
BILLING_ENABLED=false
BILLING_PROVIDER=stripe
BILLING_TRIAL_DAYS=14
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Workspace/inventory database (SQLAlchemy + Alembic). Defaults to a local
# sqlite file under ./data - no setup required. To use the bundled Postgres
# service instead, run `docker compose --profile postgres up -d` and point
# this at it (the hostname matches the "db" service name in docker-compose.yml):
# DATABASE_URL=postgresql+psycopg2://vinted_dashboard:changeme@db:5432/vinted_dashboard
DATABASE_URL=sqlite:////app/data/app.sqlite3

# Only used when DATABASE_URL points at the bundled "db" Postgres service
# (docker compose --profile postgres). Ignored otherwise.
POSTGRES_DB=vinted_dashboard
POSTGRES_USER=vinted_dashboard
POSTGRES_PASSWORD=

# One-time bootstrap workspace created the first time the app starts (and
# used by the legacy data backfill). Safe to leave at the defaults for a
# single self-hosted install.
BOOTSTRAP_WORKSPACE_NAME=Personal Workspace
BOOTSTRAP_WORKSPACE_SLUG=personal
BOOTSTRAP_OWNER_EMAIL=owner@example.com

# One-way upgrade support for pre-workspace installations. Keep this false for
# fresh/current installs. scripts/upgrade.sh performs an explicit idempotent
# backfill check; set true only when startup itself should import the old file.
RUN_LEGACY_BACKFILL=false
LEGACY_SQLITE_PATH=/app/data/vinted-history.sqlite3

WORKER_POLL_SECONDS=5
WORKER_HEARTBEAT_SECONDS=30
WORKER_HEARTBEAT_MAX_AGE_SECONDS=90
# Multi-channel stock
# BIBLIO FTP inventory sync. Keep credentials only in .env.
BIBLIO_FTP_HOST=ftp.biblio.com
BIBLIO_FTP_USERNAME=
BIBLIO_FTP_PASSWORD=
# BIBLIO recommends blank or ./ for the FTP directory.
BIBLIO_FTP_DIRECTORY=
BIBLIO_FTP_TIMEOUT_SECONDS=20
BIBLIO_FTP_FILENAME_PREFIX=vinted-dashboard
# eBay: either provide a current user access token directly...
EBAY_OAUTH_TOKEN=

# ...or preferably configure refreshable OAuth credentials.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REFRESH_TOKEN=

# Trading API settings. Site ID 0 = eBay US; change this if your selling site differs.
EBAY_SITE_ID=0
EBAY_COMPATIBILITY_LEVEL=1477
